@using ExpressVoiture.Models.ViewModels
@{
	ViewData["Title"] = "Voiture Express";
}
@model IEnumerable<VehicleListingItemViewModel>


<div class="text-center">
	<h1 class="display-4">Inventaire disponible</h1>

	<table class="table">
		<thead>
			<tr>
				<th>Marque</th>
				<th>Modèle</th>
				<th>Version</th>
				<th>Année</th>
				<th>Prix</th>
				<th>Date de disponibilité</th>
			</tr>
		</thead>

		<tbody>
			@foreach (var item in Model)
			{
				<tr>
					<td>@item.BrandName</td>
					<td>@item.ModelName</td>
					<td>@item.Version</td>
					<td>@item.Year</td>
					<td>@item.AskingPrice</td>
					<td>@item.AvailabilityDate</td>
				</tr>
			}
		</tbody>
	</table>



</div>
