@using ExpressVoiture.Models.ViewModels
@{
	ViewData["Title"] = "Accueil";
}
@model IEnumerable<VehicleListingItemSummaryViewModel>


<div class="text-center">
	<h1 class="display-4">Inventaire disponible</h1>

	<table class="table">
		<thead>
			<tr>
				<th>Marque</th>
				<th>Modèle</th>
				<th>Version</th>
				<th>Année</th>
				<th>Prix</th>
				<th>Date de disponibilité</th>
				<th>Détails</th>
			</tr>
		</thead>

		<tbody>
			@foreach (var item in Model)
			{
				<tr>
					<td>@item.BrandName</td>
					<td>@item.ModelName</td>
					<td>@item.Version</td>
					<td>@item.Year</td>
					<td>@item.AskingPrice.ToString("C")</td>
					<td>@item.AvailabilityDate</td>
					<td>
						<a asp-controller="VehicleListings"
							asp-action="Details"
							asp-route-id="@item.ListingId"
							class="btn btn-primary">
							Voir les détails
						</a>
					</td>
				</tr>
			}
		</tbody>
	</table>



</div>
