@model BrandIndexViewModel

<h1>Gestion des marques</h1>


@if (Model.EditModel is not null)
{
    <partial name="_EditForm" model="Model.EditModel" />
}
else
{
    <partial name="_CreateForm" model="Model.CreateModel" />
}

@if (TempData["Error"] is string error)
{
    <div class="alert alert-danger">
        @error
    </div>
}

<table class="table">
    <thead>
        <tr>
            <th>Nom</th>
            <th>Actions</th>
        </tr>
    </thead>

    <tbody>
        @foreach (var brand in Model.Brands)
        {
            <tr>
                <td>@brand.Name</td>
                <td>
                    <a asp-area="Admin" asp-controller="Brands" asp-action="Index" asp-route-editId="@brand.Id"
                       class="btn btn-sm btn-secondary">
                        Modifier
                    </a>

                    <button type="button"
                            class="btn btn-sm btn-danger"
                            data-bs-toggle="modal"
                            data-bs-target="#deleteBrandModal"
                            data-brand-id="@brand.Id"
                            data-brand-name="@brand.Name">
                    
                        Supprimer
                    </button>

                    
                </td>
            </tr>
        }
    </tbody>
</table>

<div class="modal fade"
     id="deleteBrandModal"
     tabindex="-1"
     aria-labelledby="deleteBrandModalLabel"
     aria-hidden="true">

    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h2 class="modal-title fs-5"
                    id="deleteBrandModalLabel">
                    Confirmer la suppression
                </h2>

                <button type="button"
                        class="btn-close"
                        data-bs-dismiss="modal"
                        aria-label="Fermer">
                
                </button>
            </div>

            <div class="modal-body">
                <p>
                    Voulez-vous vraiment supprimer la marque <strong id="deleteBrandName"></strong> ?
                </p>
            </div>

            <div class="modal-footer">
                <button type="button"
                        class="btn btn-secondary"
                        data-bs-dismiss="modal">
                    Annuler        
                </button>

                <form asp-area="Admin" 
                      asp-controller="Brands" 
                      asp-action="Delete" 
                      method="post">

                        @Html.AntiForgeryToken()

                        <input type="hidden" id="deleteBrandId" name="id" />

                        <button type="submit" 
                                class="btn btn-danger">
                            Confirmer la suppression
                        </button>
                    </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        const deleteBrandModal =
            document.getElementById('deleteBrandModal');

        deleteBrandModal.addEventListener(
            'show.bs.modal',
            event => {
                const button = event.relatedTarget;

                const brandId =
                    button.getAttribute('data-brand-id');

                const brandName =
                    button.getAttribute('data-brand-name');

                document.getElementById('deleteBrandId')
                    .value = brandId;

                document.getElementById('deleteBrandName')
                    .textContent = brandName;
            });
    </script>
}