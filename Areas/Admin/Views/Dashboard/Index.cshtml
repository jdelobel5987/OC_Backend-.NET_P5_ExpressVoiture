@model AdminDashboardViewModel

<h1>Panneau d'administration</h1>

<form method="get" asp-area="Admin" asp-controller="Dashboard" asp-action="Index">

    <div class="mb-3">
        <label asp-for="SelectedVehicleId" class="form-label">
            Véhicule sélectionné
        </label>

        <select asp-for="SelectedVehicleId" class="form-select">
            <option value="">
                -- Sélectionner un véhicule --
            </option>

            @foreach (var vehicle in Model.Vehicles)
            {
                <option value="@vehicle.Id">
                    @vehicle.DisplayName
                </option>
            }
        </select>
    </div>

    <button type="submit" class="btn btn-primary">
        Afficher
    </button>
</form>

        @if (Model.SelectedVehicleId.HasValue)
{
    <p class="mt-3">
        Véhicule sélectionné : 
        <strong>@Model.SelectedVehicleId</strong>
    </p>
}