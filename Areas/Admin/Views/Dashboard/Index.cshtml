@model AdminDashboardViewModel

<h1>Panneau d'administration</h1>

<form id="vehicle-selection-form" method="get" asp-area="Admin" asp-controller="Dashboard" asp-action="Index">

    <div class="mb-3">
        <label asp-for="SelectedVehicleId" class="form-label">
            Véhicule sélectionné
        </label>

        <select asp-for="SelectedVehicleId" id="SelectedVehicleId" class="form-select">
            
            <option value="">
                -- Sélectionner un véhicule --
            </option>

            @foreach (var vehicle in Model.Vehicles)
            {
                <option value="@vehicle.Id">
                    @vehicle.DisplayName
                </option>
            }
        </select>
    </div>

    <noscript>
        <button type="submit" class="btn btn-primary mt-2">
            Afficher
        </button>
    </noscript>
</form>


<partial name="_VehicleDetails" model="Model.SelectedVehicle" />


@section Scripts {
    <script>
        const vehicleSelect = document.getElementById('SelectedVehicleId');
        vehicleSelect.addEventListener('change', () => {
            vehicleSelect.form.requestSubmit();
        });
    </script>
}