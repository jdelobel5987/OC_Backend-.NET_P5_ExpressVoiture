@model AdminDashboardViewModel

<h1>Panneau d'administration</h1>

<section class="card mb-4">
    <div class="card-body">
        <h2 class="card-title">Actions rapides</h2>

        <div class="d-flex gap-2 flex-wrap">
            <a asp-area="Admin"
               asp-controller="Brands"
               asp-action="Index"
               class="btn btn-outline-primary">
                Gestion des marques
            </a>
            
            <a asp-area="Admin"
               asp-controller="Models"
               asp-action="Index"
               class="btn btn-outline-primary">
                Gestion des modèles
            </a>

            <a asp-area="Admin"
               asp-controller="RepairTypes"
               asp-action="Index"
               class="btn btn-outline-primary">
                Gestion des types de réparation
            </a>

        </div>
    </div>
</section>


<form id="vehicle-selection-form" method="get" asp-area="Admin" asp-controller="Dashboard" asp-action="Index">

    <div class="mb-3">
        <label asp-for="SelectedVehicleId" class="form-label">
            Véhicule sélectionné
        </label>

        <select asp-for="SelectedVehicleId" id="SelectedVehicleId" class="form-select">
            
            <option value="">
                -- Sélectionner un véhicule --
            </option>

            @foreach (var vehicle in Model.Vehicles)
            {
                <option value="@vehicle.Id">
                    @vehicle.DisplayName
                </option>
            }
        </select>
    </div>

    <noscript>
        <button type="submit" class="btn btn-primary mt-2">
            Afficher
        </button>
    </noscript>
</form>

        @if (Model.SelectedVehicle is null)
{
    <partial name="_DashboardEmpty" />
}
else
{
<partial name="_VehicleDetails" model="Model.SelectedVehicle" />
<partial name="_Purchase" model="Model.PurchaseBlock" />
<partial name="_Repairs" model="Model.RepairsBlock" />
<partial name="_VehicleListing" model="Model.ListingBlock" />   
}




@section Scripts {
    <script>
        const vehicleSelect = document.getElementById('SelectedVehicleId');
        vehicleSelect.addEventListener('change', () => {
            vehicleSelect.form.requestSubmit();
        });
    </script>
}